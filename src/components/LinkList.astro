---
// 外部リンクの一覧。url が null の項目は出さない。
export interface LinkItem {
  label: string;
  note: string;
  url: string | null;
}

interface Props {
  items: LinkItem[];
}

const items = Astro.props.items.filter((item): item is LinkItem & { url: string } => Boolean(item.url));
---

<nav aria-label="外部リンク" class="links">
  {
    items.map((item) => (
      <a class="lnk" href={item.url} rel="noopener">
        {item.label}
        <span class="lnk-note">{item.note}</span>
        <span class="lnk-arrow" aria-hidden="true">
          →
        </span>
      </a>
    ))
  }
</nav>

<style>
  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    border-top: 1px solid var(--color-line);
    margin-top: 12px;
  }

  .lnk {
    min-height: 56px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    color: var(--color-ink);
    font-size: 15px;
    padding-right: 16px;
  }

  .lnk:hover {
    color: var(--color-ink);
  }

  .lnk-note {
    font-size: 13px;
    color: var(--color-muted);
  }

  .lnk-arrow {
    margin-left: auto;
    color: var(--color-accent);
    transition: transform 0.15s;
  }

  .lnk:hover .lnk-arrow {
    transform: translateX(3px);
  }
</style>
