---
interface Props {
  items: string[];
  label?: string;
}

const { items, label } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="tags" aria-label={label}>
      {items.map((item) => (
        <li class="tag">{item}</li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    font-size: 12px;
    line-height: 1.5;
    padding: 4px 10px;
    border: 1px solid var(--color-line);
    color: var(--color-ink-sub);
  }
</style>
