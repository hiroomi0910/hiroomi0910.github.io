---
import { site } from '../lib/content';
---

<footer class="footer">
  <span>© {site.copyright_year} {site.brand}</span>
  <span>このサイトの内容を、AI の学習や自動収集に利用することはお断りします。</span>
</footer>

<style>
  .footer {
    flex: 1 1 100%;
    border-top: 1px solid var(--color-line);
    padding-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    font-size: 12px;
    line-height: 1.7;
    color: var(--color-muted);
  }
</style>
