---
// 入口ページ。docs/design/entrance-b2.dc.html（B-2 案）を素の HTML/CSS に起こしたもの。
import ContactButton from '../components/ContactButton.astro';
import Footer from '../components/Footer.astro';
import LinkList, { type LinkItem } from '../components/LinkList.astro';
import Base from '../layouts/Base.astro';
import { getEntrancePhoto } from '../lib/cloudinary';
import { profile, site } from '../lib/content';

const photo = await getEntrancePhoto(site.entrance.photo);

const taglineLines = profile.tagline_serif.split('\n');
const photographyHost = new URL(site.links.photography).host;

const links: LinkItem[] = [
  { label: 'GitHub', note: 'コード', url: site.links.github },
  { label: 'Qiita', note: '技術記事', url: site.links.qiita },
  { label: 'VS Code 拡張', note: '個人開発', url: site.links.vscode_extension.open_vsx },
  { label: 'LinkedIn', note: 'プロフィール', url: site.links.linkedin },
];

const serifText = [site.display_name, profile.tagline_serif, `${profile.years_on_web}年`, 'エンジニアとしての仕事', 'ZEKKEI PORTRAIT'].join('');
---

<Base title={`${site.display_name} — ポートフォリオ`} description={profile.lead} serifText={serifText}>
  <link slot="head" rel="preconnect" href="https://res.cloudinary.com" />
  <div class="page" style={`--color-accent: ${site.entrance.accent}`}>
    <div class="wrap">
      <header class="intro">
        <span class="eyebrow">PORTFOLIO</span>
        <h1 class="name">{site.display_name}</h1>
        <div class="rule" aria-hidden="true"></div>
        <p class="tagline">
          {taglineLines.map((line, i) => (i === 0 ? line : [<br />, line]))}
        </p>
        <p class="lead">{profile.lead}</p>
        <dl class="facts">
          <dt>拠点</dt>
          <dd>{profile.location}・{profile.work_style}</dd>
          <dt>得意</dt>
          <dd>{profile.specialties.join(' / ')}</dd>
        </dl>
        <ContactButton from="top" />
      </header>

      <main id="main" class="entries">
        <a class="row" href="/engineer/">
          <div class="swatch swatch-accent" aria-hidden="true">
            <span class="num">01</span>
            <div class="years">
              <span class="years-value">{profile.years_on_web}<span class="years-unit">年</span></span>
              <span class="years-label">Web をつくってきた年数</span>
            </div>
          </div>
          <div class="row-body">
            <span class="row-label">ENGINEERING</span>
            <span class="row-title">エンジニアとしての<span class="nowrap">仕事<span class="row-arrow" aria-hidden="true">→</span></span></span>
            <span class="row-text">関わってきた案件、個人開発の VS Code 拡張、技術記事をまとめています。</span>
            <span class="chips">
              <span class="chip">経歴</span>
              <span class="chip">個人開発</span>
              <span class="chip">技術記事</span>
            </span>
          </div>
        </a>

        <a class="row" href={site.links.photography} target="_blank" rel="noopener">
          <div class:list={['swatch', 'swatch-photo', { 'has-photo': photo }]}>
            {
              photo && (
                <img
                  class="photo"
                  src={photo.src}
                  srcset={photo.srcset}
                  sizes="(max-width: 640px) 100vw, 360px"
                  width={photo.width}
                  height={photo.height}
                  alt={photo.alt}
                  loading="lazy"
                  decoding="async"
                />
              )
            }
            <span class="num" aria-hidden="true">02</span>
          </div>
          <div class="row-body">
            <span class="row-label">PHOTOGRAPHY</span>
            <span class="row-title">ZEKKEI PORTRAIT</span>
            <span class="row-text">ポートレート作品集</span>
            <span class="row-host">
              {photographyHost}
              <span class="visually-hidden">（新しいタブで開きます）</span>
              <svg class="row-arrow-ext" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17L17 7M9 7h8v8" />
              </svg>
            </span>
          </div>
        </a>

        <LinkList items={links} />
      </main>

      <Footer />
    </div>
  </div>
</Base>

<script>
  // iPhone の Safari は、ページにタッチの処理が無いと :active の見た目を出さないことがある。
  // 何もしない処理を登録して、入口カードを押したときの沈み込みを出す。
  document.addEventListener('touchstart', () => {}, { passive: true });
</script>

<style>
  .page {
    min-height: 100vh;
    padding: 88px var(--gutter) 40px;
  }

  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    column-gap: 72px;
    row-gap: 56px;
    align-items: flex-start;
  }

  .intro {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.24em;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .name {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 64px;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .rule {
    width: 40px;
    height: 2px;
    background: var(--color-accent);
  }

  .tagline {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.75;
  }

  .lead {
    margin: 0;
    font-size: 15px;
    line-height: 1.95;
    color: var(--color-ink-sub);
  }

  .facts {
    margin: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 20px;
    row-gap: 8px;
    font-size: 14px;
    line-height: 1.6;
  }

  .facts dt {
    color: var(--color-muted);
  }

  .facts dd {
    margin: 0;
  }

  .entries {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    text-decoration: none;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    /* 押したときに沈む分の影（押すと 0 になる） */
    box-shadow: 0 3px 0 var(--color-line);
    -webkit-tap-highlight-color: transparent;
    transition:
      background 0.15s,
      border-color 0.15s,
      transform 0.22s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.22s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* 押したとき：速く沈み（70ms）、離すとゆっくり戻る（220ms） */
  .row:active {
    transform: translateY(3px);
    box-shadow: 0 0 0 var(--color-line);
    transition-duration: 0.15s, 0.15s, 0.07s, 0.07s;
    transition-timing-function: ease, ease, ease-out, ease-out;
  }

  /* 行き先を示す矢印：ホバーで少し、押すとさらに進む */
  .row-arrow,
  .row-arrow-ext {
    display: inline-block;
    color: var(--color-accent);
    transition: transform 0.24s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* スマホで「事」だけが次の行に残らないよう、「仕事 →」をまとめて折り返す */
  .nowrap {
    white-space: nowrap;
  }

  .row-arrow {
    margin-left: 0.4em;
    font-family: var(--font-sans);
    font-weight: 400;
  }

  .row:hover .row-arrow {
    transform: translateX(4px);
  }

  .row:active .row-arrow {
    transform: translateX(10px);
    transition-duration: 0.09s;
  }

  .row:hover .row-arrow-ext {
    transform: translate(2px, -2px);
  }

  .row:active .row-arrow-ext {
    transform: translate(5px, -5px);
    transition-duration: 0.09s;
  }

  /* 動きを減らす設定の人には、動きを止めて枠の色だけで押したことを伝える */
  @media (prefers-reduced-motion: reduce) {
    .row,
    .row-arrow,
    .row-arrow-ext {
      transition: background 0.15s, border-color 0.15s;
    }

    .row:active,
    .row:hover .row-arrow,
    .row:active .row-arrow,
    .row:hover .row-arrow-ext,
    .row:active .row-arrow-ext {
      transform: none;
    }

    .row:active {
      border-color: var(--color-accent);
    }
  }

  .row:hover {
    color: var(--color-ink);
    background: var(--color-surface-hover);
    border-color: var(--color-line-hover);
  }

  .row:hover .row-title {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .swatch {
    position: relative;
    flex: 1 1 220px;
    min-height: 236px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  .swatch-accent {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .swatch-photo {
    background: var(--color-photo-placeholder);
    color: var(--color-photo-placeholder-ink);
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .num {
    position: relative;
    font-size: 12px;
    letter-spacing: 0.2em;
    line-height: 1.5;
  }

  .has-photo .num {
    align-self: flex-start;
    padding: 2px 8px;
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .years {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .years-value {
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 600;
    line-height: 1;
  }

  .years-unit {
    font-size: 20px;
    margin-left: 6px;
  }

  .years-label {
    font-size: 12px;
    letter-spacing: 0.12em;
    line-height: 1.5;
  }

  .row-body {
    flex: 999 1 300px;
    padding: 36px 40px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-content: center;
  }

  .row-label {
    font-size: 12px;
    letter-spacing: 0.22em;
    line-height: 1.5;
    color: var(--color-accent);
    font-weight: 700;
  }

  .row-title {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.4;
  }

  .row-text {
    font-size: 15px;
    line-height: 1.85;
    color: var(--color-ink-sub);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    font-size: 12px;
    line-height: 1.5;
    padding: 4px 10px;
    background: var(--color-tag-bg);
    color: var(--color-ink);
  }

  .row-host {
    font-size: 13px;
    color: var(--color-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 480px) {
    .page {
      padding-top: 56px;
    }

    .name {
      font-size: 52px;
    }

    .row-body {
      padding: 28px 24px;
    }
  }
</style>
