{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/", "http://localhost/engineer/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.8, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.8, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
